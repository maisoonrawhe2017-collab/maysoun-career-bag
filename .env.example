# Copy this file to `.env` (or `.env.local`) and fill in values as needed.
# For GitHub Pages deployment you do NOT need any of these —
# the GitHub Actions workflow sets BASE_PATH automatically.

# Base path for asset URLs. Leave empty for local dev.
# Set to /<your-repo-name> when building manually for GitHub project pages.
BASE_PATH=

# Same value, exposed to client-side code.
NEXT_PUBLIC_BASE_PATH=
